# Database Configuration
DATABASE_URL=sqlite:///news_database.db

# OpenAI Configuration (Optional)
# If not provided, AI-powered features will be disabled:
# - News summarization and relevance assessment
# - Keyword extraction for news search
# - Background news fetching and processing
# Uncomment and set your API key to enable these features:
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# JWT Authentication
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Sentry (Optional)
# SENTRY_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# CORS Configuration
# Use comma-separated values for multiple origins
# CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Background Scheduler
NEWS_FETCH_INTERVAL_MINUTES=100

# External APIs (Optional - defaults provided)
# NECESSITIES_PRICE_API_URL=https://opendata.ey.gov.tw/api/ConsumerProtection/NecessitiesPrice
# UDN_NEWS_API_URL=https://udn.com/api/more

# Logging
LOG_LEVEL=INFO
