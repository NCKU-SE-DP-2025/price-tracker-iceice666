# Database Configuration
DATABASE_URL=sqlite:///news_database.db
# Enable SQL query logging (useful for development, disable in production)
DATABASE_ECHO=false
# Connection pool settings (for databases that support pooling like PostgreSQL)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# OpenAI Configuration (Optional)
# If not provided, AI-powered features will be disabled:
# - News summarization and relevance assessment
# - Keyword extraction for news search
# - Background news fetching and processing
# Uncomment and set your API key to enable these features:
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# JWT Authentication (REQUIRED - SECURITY CRITICAL)
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER use the default value in production!
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment (development, staging, production)
# Production enables HTTPS enforcement and stricter security
ENVIRONMENT=development

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_VOTING=30/minute

# Sentry (Optional)
# SENTRY_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# CORS Configuration
# Use comma-separated values for multiple origins
# Development default:
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Trusted Hosts (production only - prevents host header injection attacks)
# Use "*" for development, specific domains for production
TRUSTED_HOSTS=*
# Production example:
# TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Background Scheduler
NEWS_FETCH_INTERVAL_MINUTES=100

# External APIs (Optional - defaults provided)
# NECESSITIES_PRICE_API_URL=https://opendata.ey.gov.tw/api/ConsumerProtection/NecessitiesPrice
# UDN_NEWS_API_URL=https://udn.com/api/more

# Logging
LOG_LEVEL=INFO
